# Copia este archivo como .env (git lo ignora). Todo es opcional.

# OpenSky: sin esto funciona en modo anónimo (cupo diario pequeño). Crea una cuenta gratuita en
# https://opensky-network.org, entra en "Account" → "API Client" y pega aquí el cliente.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# aisstream.io: barcos de todo el mundo (sin clave solo se ven los del Báltico vía Digitraffic).
# Clave gratuita en https://aisstream.io (entrar con GitHub → API Keys).
AISSTREAM_API_KEY=

# Windy (opcional, recomendado): cámaras públicas de todo el mundo (más de 70 000, incluidas las de Ecuador que
# existan en Windy). Clave gratuita en https://api.windy.com/keys (elige «Webcams API»).
WINDY_API_KEY=

# CARTO (opcional): su mapa oscuro Dark Matter exige clave desde el 25-09-2026. Sin ella se usa el mapa gris oscuro
# de Esri, que no pide clave. Clave gratuita (uso no comercial) en https://carto.com/basemaps/apikey/
CARTO_API_KEY=

# Esquina suroeste del plano doméstico. No subas tu dirección real al repositorio: va solo en .env.
PLANO_LAT=
PLANO_LNG=

# --- RuView real ---------------------------------------------------------------------------------------------
# Con RUVIEW_URL, Argos lee el sensing-server de RuView y apaga su emulador. Sin él, usa el emulador (SIMULADO).
#   Docker con el perfil ruview (ESP32):  RUVIEW_URL=ws://ruview:3001/ws/sensing
#   RuView nativo en este PC (Wi-Fi):     RUVIEW_URL=ws://127.0.0.1:3001/ws/sensing   (Argos con npm, no en Docker)
RUVIEW_URL=
# Secreto compartido con RuView. Genera uno en PowerShell con: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
RUVIEW_API_TOKEN=
# esp32 = nodos reales; simulated = la demo de RuView (Argos la marca como DEMO).
CSI_SOURCE=esp32
# Calibración: punto del plano (en metros) donde cae el centro de la sala de RuView, giro en grados y escala.
RUVIEW_ORIGEN_X=
RUVIEW_ORIGEN_Y=
RUVIEW_GIRO=0
RUVIEW_ESCALA=1

# Solo sin RUVIEW_URL: 1 = emulador; 0 = esperar lecturas externas en /ingest/ruview?token=ARGOS_INGEST_TOKEN.
RUVIEW_SIMULADOR=1
RUVIEW_OBJETIVOS=2
ARGOS_INGEST_TOKEN=

PORT=8787
